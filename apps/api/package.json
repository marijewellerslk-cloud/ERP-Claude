{
  "name": "@mari-erp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:safe": "tsx src/scripts/recreate-admin.ts",
    "db:studio": "drizzle-kit studio",
    "db:prepare": "npm run db:migrate && npm run db:seed:safe",
    "script:reset-inventory": "tsx src/scripts/reset-and-populate-inventory.ts",
    "script:create-default-label": "tsx src/scripts/create-default-label-template.ts",
    "script:migrate-supplier-accounts": "tsx src/scripts/migrate-supplier-accounts.ts",
    "script:seed-loyalty-rewards": "tsx src/scripts/seed-loyalty-rewards.ts",
    "script:migrate-customers-crm": "tsx src/scripts/migrate-existing-customers.ts",
    "script:recreate-admin": "tsx src/scripts/recreate-admin.ts",
    "script:reset-admin-password": "tsx src/scripts/reset-admin-password.ts",
    "test": "cross-env NODE_ENV=test DATABASE_NAME=mari_erp_test vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/lib-storage": "^3.985.0",
    "@green-api/whatsapp-api-client": "^0.4.4",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "postgres": "^3.4.5",
    "redis": "^4.7.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
