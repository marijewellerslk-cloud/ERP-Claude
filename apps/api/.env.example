# Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db

# Authentication
# Generate a secure secret using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Backup Configuration (Optional)
BACKUP_DIR=./backups
TEMP_RESTORE_DIR=./temp_restores
UPLOAD_BACKUPS_TO_CLOUD=false
BACKUP_S3_ENDPOINT=
BACKUP_AWS_REGION=us-east-1
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_BUCKET_NAME=erp-backups

# Restore Configuration (Optional - reuse backup configs or specify separate)
MINIO_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Email Configuration (Pending implementation)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# WhatsApp Configuration (Pending implementation)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
